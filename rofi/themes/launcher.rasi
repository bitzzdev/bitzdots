/* Default launcher theme (Nord-Oneline layout) */

* {
    bg0:           #2e3440;
    bg1:           #3b4252;
    fg0:           #eceff4;
    fg1:           #d8dee9;
    accent:        #88c0d0;
    select:        #434c5e;
    on-select:     #eceff4;
    border-subtle: #4c566a;

    background-color: transparent;
    text-color:       @fg0;
    font:            "JetBrainsMono Nerd Font 10";

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:           north;
    width:              100%;
    background-color:   @bg0;
    children:           [ mainbox, message ];
}

mainbox {
    orientation:    horizontal;
    children:       [ inputbar, listview ];
}

inputbar {
    width:      25%;
    padding:    4px 12px;
    spacing:    8px;
    children:   [ prompt, entry ];
    background-color: @bg1;
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    font:       "JetBrainsMono Nerd Font Bold 10";
    text-color: @accent;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg1;
    cursor:            text;
    text-color:        @fg0;
}

listview {
    layout:  horizontal;
    spacing: 2px;
    padding: 0px 4px;
}

element {
    padding: 4px 12px;
    spacing: 6px;
}

element normal active {
    text-color: @accent;
}

element alternate active {
    text-color: @accent;
}

element selected {
    background-color: @select;
}

element selected normal {
    background-color: @select;
}

element selected active {
    background-color: @accent;
}

element-icon {
    size: 1.1em;
}

element-text {
    text-color: inherit;
}

element selected text {
    text-color: @on-select;
}
