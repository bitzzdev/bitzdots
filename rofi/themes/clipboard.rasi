/* Default clipboard manager theme (M3 / Nord centered vertical layout) */

* {
    bg0:           #2e3440;
    bg1:           #3b4252;
    fg0:           #eceff4;
    fg1:           #d8dee9;
    accent:        #88c0d0;
    select:        #434c5e;
    on-select:     #eceff4;
    border-subtle: #4c566a;

    background-color: transparent;
    text-color:       @fg0;
    font:            "JetBrainsMono Nerd Font 10";

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:           center;
    anchor:             center;
    width:              640px;
    border:             2px;
    border-color:       @accent;
    border-radius:      0;
    background-color:   @bg0;
    children:           [ mainbox, message ];
}

mainbox {
    orientation:    vertical;
    children:       [ inputbar, listview ];
}

inputbar {
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
    background-color: @bg1;
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    font:       "JetBrainsMono Nerd Font Bold 11";
    text-color: @accent;
}

entry {
    placeholder:       "Type to filter clipboard...";
    placeholder-color: @fg1;
    cursor:            text;
    text-color:        @fg0;
}

listview {
    lines:        10;
    columns:      1;
    spacing:      4px;
    padding:      8px;
    fixed-height: false;
}

element {
    padding:       8px 12px;
    spacing:       10px;
    border-radius: 0;
}

element normal active {
    text-color: @accent;
}

element alternate active {
    text-color: @accent;
}

element selected {
    background-color: @select;
}

element selected normal {
    background-color: @select;
}

element selected active {
    background-color: @accent;
}

element-icon {
    size: 20px;
}

element-text {
    text-color: inherit;
}

element selected text {
    text-color: @on-select;
}
