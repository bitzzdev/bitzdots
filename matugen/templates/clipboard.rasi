/* Auto-generated by matugen — clipboard manager theme */
/* Material Design 3 (M3) Semantic Color Hierarchy */

* {
    bg0:           {{colors.surface.default.hex}};
    bg1:           {{colors.surface_container_low.default.hex}};
    fg0:           {{colors.on_surface.default.hex}};
    fg1:           {{colors.on_surface_variant.default.hex}};
    accent:        {{colors.primary.default.hex}};
    select:        {{colors.primary_container.default.hex}};
    on-select:     {{colors.on_primary_container.default.hex}};
    border-subtle: {{colors.outline_variant.default.hex}};

    background-color: transparent;
    text-color:       @fg0;
    font:            "JetBrainsMono Nerd Font 10";

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:           center;
    anchor:             center;
    width:              640px;
    border:             2px;
    border-color:       @accent;
    border-radius:      0;
    background-color:   @bg0;
    children:           [ mainbox, message ];
}

mainbox {
    orientation:    vertical;
    children:       [ inputbar, listview ];
}

inputbar {
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
    background-color: @bg1;
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    font:       "JetBrainsMono Nerd Font Bold 11";
    text-color: @accent;
}

entry {
    placeholder:       "Type to filter clipboard...";
    placeholder-color: @fg1;
    cursor:            text;
    text-color:        @fg0;
}

listview {
    lines:        10;
    columns:      1;
    spacing:      4px;
    padding:      8px;
    fixed-height: false;
}

element {
    padding:       8px 12px;
    spacing:       10px;
    border-radius: 0;
}

element normal active {
    text-color: @accent;
}

element alternate active {
    text-color: @accent;
}

element selected {
    background-color: @select;
}

element selected normal {
    background-color: @select;
}

element selected active {
    background-color: @accent;
}

element-icon {
    size: 20px;
}

element-text {
    text-color: inherit;
}

element selected text {
    text-color: @on-select;
}
