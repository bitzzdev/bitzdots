/* Auto-generated by matugen — power menu theme */

* {
    bg0:    {{colors.surface.default.hex}};
    bg1:    {{colors.surface_container.default.hex}};
    fg0:    {{colors.on_surface.default.hex}};
    fg1:    {{colors.on_surface_variant.default.hex}};
    accent: {{colors.primary.default.hex}};
    select: {{colors.surface_container_highest.default.hex}};
    urgent: {{colors.error.default.hex}};

    background-color: transparent;
    text-color:       @fg0;
    font:             "JetBrainsMono Nerd Font Medium 12";
    icon-size:        24px;
}

window {
    width:            260px;
    border:           3px;
    border-color:     @accent;
    border-radius:    0;
    background-color: @bg0;
}

mainbox {
    children: [ listview ];
}

listview {
    lines:            6;
    columns:          1;
    spacing:          1px;
    padding:          6px;
    fixed-height:     false;
}

element {
    padding:          10px 14px;
    spacing:          14px;
    border-radius:    0;
}

element normal {
    background-color: transparent;
    border:           1px;
    border-color:     @accent;
    text-color:       @fg0;
}
element selected {

    background-color: @select;
    border:           3px;
    border-color:     @accent;
}

element selected text {
    text-color:       @accent;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}
