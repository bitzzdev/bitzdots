/* Auto-generated by matugen — app launcher theme */

* {
    bg0:    {{colors.surface.default.hex}};
    bg1:    {{colors.surface_container.default.hex}};
    fg0:    {{colors.on_surface.default.hex}};
    fg1:    {{colors.on_surface_variant.default.hex}};
    accent: {{colors.primary.default.hex}};
    select: {{colors.surface_container_highest.default.hex}};

    background-color: transparent;
    text-color:       @fg0;
    font:            "JetBrainsMono Nerd Font Medium 10";
}

window {
    width:            600px;
    border:           3px;
    border-color:     @accent;
    border-radius:    0;
    background-color: @bg0;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    padding:          12px 16px 8px;
    background-color: @bg1;
    children:         [ prompt, entry ];
}

prompt {
    font:            "JetBrainsMono Nerd Font Bold 12";
    text-color:      @accent;
}

entry {
    placeholder:     "Search apps...";
    placeholder-color: @fg1;
    cursor:          text;
}

listview {
    columns:      4;
    lines:        3;
    spacing:      6px;
    padding:      10px;
    fixed-height: false;
    flow:         horizontal;
}

element {
    orientation:      vertical;
    padding:          8px;
    spacing:          6px;
    border-radius:    0;
}

element normal {
    background-color: transparent;
    border:           1px;
    border-color:     @accent;
    text-color:       @fg0;
}
element selected {

    background-color: @select;
    border:           3px;
    border-color:     @accent;
}

element selected text {
    text-color:       @accent;
}

element-icon {
    size:             64px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element-text {
    horizontal-align: 0.5;
    text-color:       @fg1;
    font:            "JetBrainsMono Nerd Font Medium 9";
}
