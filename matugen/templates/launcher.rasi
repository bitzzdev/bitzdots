/* Auto-generated by matugen — app launcher theme */
/* Material Design 3 (M3) Semantic Color Hierarchy */
/* Nord-Oneline bar style layout */

* {
    bg0:           {{colors.surface.default.hex}};
    bg1:           {{colors.surface_container_low.default.hex}};
    fg0:           {{colors.on_surface.default.hex}};
    fg1:           {{colors.on_surface_variant.default.hex}};
    accent:        {{colors.primary.default.hex}};
    select:        {{colors.primary_container.default.hex}};
    on-select:     {{colors.on_primary_container.default.hex}};
    border-subtle: {{colors.outline_variant.default.hex}};

    background-color: transparent;
    text-color:       @fg0;
    font:            "JetBrainsMono Nerd Font 10";

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:           north;
    width:              100%;
    background-color:   @bg0;
    children:           [ mainbox, message ];
}

mainbox {
    orientation:    horizontal;
    children:       [ inputbar, listview ];
}

inputbar {
    width:      25%;
    padding:    4px 12px;
    spacing:    8px;
    children:   [ prompt, entry ];
    background-color: @bg1;
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    font:       "JetBrainsMono Nerd Font Bold 10";
    text-color: @accent;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg1;
    cursor:            text;
    text-color:        @fg0;
}

listview {
    layout:  horizontal;
    spacing: 2px;
    padding: 0px 4px;
}

element {
    padding: 4px 12px;
    spacing: 6px;
}

element normal active {
    text-color: @accent;
}

element alternate active {
    text-color: @accent;
}

element selected {
    background-color: @select;
}

element selected normal {
    background-color: @select;
}

element selected active {
    background-color: @accent;
}

element-icon {
    size: 1.1em;
}

element-text {
    text-color: inherit;
}

element selected text {
    text-color: @on-select;
}
